{
  "layout": "grid",
  "theme": "dark",
  "gridCols": 12,
  "gridRowHeight": 80,
  "globalSettings": {
    "timezone": "Asia/Bangkok",
    "currency": "THB",
    "numberFormat": "th-TH",
    "dateFormat": "DD/MM/YYYY",
    "animations": true,
    "responsiveBreakpoints": {
      "mobile": 768,
      "tablet": 1024,
      "desktop": 1200
    }
  },
  "filters": [
    {
      "id": "dateRange",
      "type": "dateRange",
      "field": "docDate",
      "label": "ช่วงวันที่",
      "defaultValue": {
        "start": "2024-01-01",
        "end": "2024-12-31"
      },
      "position": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 1
      }
    },
    {
      "id": "branchFilter",
      "type": "multiSelect",
      "field": "branch",
      "label": "สาขา",
      "options": "dynamic",
      "position": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 1
      }
    },
    {
      "id": "productGroupFilter",
      "type": "dropdown",
      "field": "prodGrp",
      "label": "กลุ่มสินค้า",
      "allowAll": true,
      "position": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 1
      }
    }
  ],
  "widgets": [
    {
      "id": "widget_advanced_bar_001",
      "title": "📊 Advanced Bar Chart: Top Products by Revenue",
      "type": "bar",
      "position": {
        "x": 0,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "dataConfig": {
        "table": "VVPVSG_INVENTORY_001_VIEW_001",
        "xField": "prodName",
        "yField": "totalFromBuyPrice",
        "aggregation": "sum",
        "groupBy": ["prodName"],
        "orderBy": [
          {
            "field": "totalFromBuyPrice",
            "direction": "DESC"
          }
        ],
        "filters": [
          {
            "field": "totalFromBuyPrice",
            "operator": ">",
            "value": 1000
          }
        ]
      },
      "styleConfig": {
        "colors": ["#3b82f6", "#1d4ed8", "#1e40af", "#1e3a8a"],
        "gradient": true,
        "showLegend": true,
        "legendPosition": "top",
        "showGrid": true,
        "gridStyle": "dashed",
        "showLabels": true,
        "labelRotation": 45,
        "barWidth": 0.8,
        "borderRadius": 4,
        "shadow": true,
        "animation": {
          "enabled": true,
          "duration": 800,
          "easing": "easeInOutQuart"
        }
      },
      "tooltipConfig": {
        "enabled": true,
        "template": "<b>{prodName}</b><br/>ยอดขาย: ฿{totalFromBuyPrice:,.2f}",
        "backgroundColor": "rgba(0,0,0,0.8)",
        "textColor": "#fff",
        "borderRadius": 8,
        "followCursor": true
      },
      "interactionConfig": {
        "clickable": true,
        "drillDown": {
          "enabled": true,
          "target": "widget_detail_table_001",
          "params": ["prodName"]
        },
        "zoom": true,
        "pan": false
      },
      "conditionalFormatting": [
        {
          "condition": "value > 50000",
          "style": {
            "color": "#10b981",
            "fontWeight": "bold"
          }
        },
        {
          "condition": "value < 10000",
          "style": {
            "color": "#ef4444",
            "opacity": 0.7
          }
        }
      ],
      "visible": true,
      "refreshInterval": 300000
    },
    {
      "id": "widget_advanced_line_001",
      "title": "📈 Sales Trend Over Time",
      "type": "line",
      "position": {
        "x": 6,
        "y": 1,
        "w": 6,
        "h": 5
      },
      "dataConfig": {
        "table": "VVPVSG_INVENTORY_001_VIEW_001",
        "xField": "docDate",
        "yField": "totalFromBuyPrice",
        "aggregation": "sum",
        "groupBy": ["docDate"],
        "orderBy": [
          {
            "field": "docDate",
            "direction": "ASC"
          }
        ],
        "dateGrouping": "day",
        "fillMissingDates": true
      },
      "styleConfig": {
        "lineWidth": 3,
        "pointSize": 6,
        "pointHoverSize": 8,
        "showPoints": true,
        "showArea": false,
        "areaOpacity": 0.3,
        "showLegend": true,
        "legendPosition": "bottom",
        "showGrid": true,
        "gridColor": "#374151",
        "crosshair": true,
        "animation": {
          "enabled": true,
          "duration": 1200,
          "delay": 200
        }
      },
      "axisConfig": {
        "xAxis": {
          "title": "วันที่",
          "format": "DD/MM/YYYY",
          "rotation": 0,
          "showTicks": true,
          "tickInterval": "auto"
        },
        "yAxis": {
          "title": "ยอดขาย (บาท)",
          "format": "฿{value:,.0f}",
          "min": 0,
          "gridLines": true
        }
      },
      "tooltipConfig": {
        "enabled": true,
        "template": "<b>{docDate}</b><br/>ยอดขาย: ฿{totalFromBuyPrice:,.2f}"
      },
      "visible": true
    },
    {
      "id": "widget_advanced_area_001",
      "title": "🌊 Cost Breakdown by Product Group",
      "type": "area",
      "position": {
        "x": 0,
        "y": 6,
        "w": 8,
        "h": 4
      },
      "dataConfig": {
        "table": "VVPVSG_INVENTORY_001_VIEW_001",
        "xField": "prodGrp",
        "yField": "totalFromBuyPrice",
        "aggregation": "sum",
        "groupBy": ["prodGrp"],
        "orderBy": [
          {
            "field": "totalFromBuyPrice",
            "direction": "DESC"
          }
        ]
      },
      "styleConfig": {
        "areaOpacity": 0.7,
        "lineWidth": 2,
        "showPoints": false,
        "showLegend": true,
        "legendPosition": "top-right",
        "gradient": true,
        "animation": {
          "enabled": true,
          "duration": 1000,
          "type": "slide"
        }
      },
      "interactionConfig": {
        "brushSelection": true,
        "zoom": true,
        "resetZoom": true
      },
      "visible": true
    },
    {
      "id": "widget_advanced_pie_001",
      "title": "🥧 Advanced Pie Chart: Revenue by Product Group",
      "type": "pie",
      "position": {
        "x": 8,
        "y": 6,
        "w": 4,
        "h": 4
      },
      "dataConfig": {
        "table": "VVPVSG_INVENTORY_001_VIEW_001",
        "labelField": "prodGrp",
        "valueField": "totalFromBuyPrice",
        "aggregation": "sum",
        "groupBy": ["prodGrp"],
        "orderBy": [
          {
            "field": "totalFromBuyPrice",
            "direction": "DESC"
          }
        ],
        "otherThreshold": 0.02
      },
      "styleConfig": {
        "innerRadius": 40,
        "outerRadius": 100,
        "startAngle": -90,
        "endAngle": 270,
        "showLabels": true,
        "labelPosition": "outside",
        "showValues": true,
        "valueFormat": "฿{value:,.0f}",
        "showPercentage": true,
        "showLegend": true,
        "legendPosition": "right",
        "colors": [
          "#3b82f6",
          "#10b981",
          "#f59e0b",
          "#ef4444",
          "#8b5cf6",
          "#06b6d4",
          "#84cc16",
          "#f97316"
        ],
        "hoverEffect": {
          "scale": 1.1,
          "shadowBlur": 10
        },
        "animation": {
          "enabled": true,
          "duration": 800,
          "type": "rotate"
        }
      },
      "tooltipConfig": {
        "enabled": true,
        "template": "<b>{prodGrp}</b><br/>ยอดขาย: ฿{totalFromBuyPrice:,.2f}<br/>สัดส่วน: {percentage:.1f}%"
      },
      "visible": true
    },
    {
      "id": "widget_advanced_doughnut_001",
      "title": "🍩 Doughnut Chart: Branch Performance",
      "type": "doughnut",
      "position": {
        "x": 0,
        "y": 10,
        "w": 4,
        "h": 4
      },
      "dataConfig": {
        "table": "VVPVSG_INVENTORY_001_VIEW_001",
        "labelField": "branch",
        "valueField": "totalFromBuyPrice",
        "aggregation": "sum",
        "groupBy": ["branch"],
        "orderBy": [
          {
            "field": "totalFromBuyPrice",
            "direction": "DESC"
          }
        ]
      },
      "styleConfig": {
        "innerRadius": 60,
        "outerRadius": 90,
        "cornerRadius": 8,
        "showLabels": true,
        "centerText": {
          "enabled": true,
          "title": "Total Sales",
          "value": "auto",
          "format": "฿{value:,.0f}"
        },
        "gradientColors": true,
        "animation": {
          "enabled": true,
          "duration": 1000,
          "easing": "easeOutBounce"
        }
      },
      "visible": true
    },
    {
      "id": "widget_advanced_scatter_001",
      "title": "🎯 Scatter Plot: Price vs Quantity Analysis",
      "type": "scatter",
      "position": {
        "x": 4,
        "y": 10,
        "w": 4,
        "h": 4
      },
      "dataConfig": {
        "table": "VVPVSG_INVENTORY_001_VIEW_001",
        "xField": "buyPrice",
        "yField": "qtyFromThisDoc"
      },
      "styleConfig": {
        "pointOpacity": 0.7,
        "pointBorder": 2,
        "showTrendLine": true,
        "trendLineColor": "#ef4444",
        "trendLineStyle": "dashed",
        "colorPalette": [
          "#3b82f6",
          "#10b981",
          "#f59e0b",
          "#ef4444",
          "#8b5cf6",
          "#06b6d4"
        ],
        "showLegend": true,
        "legendPosition": "bottom"
      },
      "axisConfig": {
        "xAxis": {
          "title": "ราคาซื้อ (บาท)",
          "scale": "linear",
          "format": "฿{value:,.0f}"
        },
        "yAxis": {
          "title": "จำนวน (ชิ้น)",
          "scale": "linear",
          "format": "{value:,.0f}"
        }
      },
      "tooltipConfig": {
        "enabled": true,
        "template": "<b>Product:</b> {prodName}<br/><b>Price:</b> ฿{buyPrice:,.2f}<br/><b>Qty:</b> {qtyFromThisDoc:,.0f}<br/><b>Total:</b> ฿{totalFromBuyPrice:,.2f}"
      },
      "visible": true
    },
    {
      "id": "advanced_table_with_filters",
      "title": "📋 Advanced Table with Config Filters",
      "type": "table",
      "position": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 9
      },
      "dataConfig": {
        "table": "VVPVSG_INVENTORY_001_VIEW_001",
        "columns": [
          {
            "field": "prodName",
            "title": "ชื่อสินค้า",
            "width": 200,
            "sortable": true,
            "filterable": true
          },
          {
            "field": "prodGrp",
            "title": "กลุ่มสินค้า",
            "width": 120,
            "sortable": true,
            "filterable": true
          },
          {
            "field": "branch",
            "title": "สาขา",
            "width": 100,
            "sortable": true,
            "filterable": true
          },
          {
            "field": "buyPrice",
            "title": "ราคาซื้อ",
            "width": 100,
            "sortable": true,
            "format": "currency",
            "align": "right"
          },
          {
            "field": "qtyFromThisDoc",
            "title": "จำนวน",
            "width": 80,
            "sortable": true,
            "format": "number",
            "align": "right"
          },
          {
            "field": "totalFromBuyPrice",
            "title": "รวม",
            "width": 120,
            "sortable": true,
            "format": "currency",
            "align": "right"
          },
          {
            "field": "docDate",
            "title": "วันที่",
            "width": 100,
            "sortable": true,
            "format": "date"
          },
          {
            "field": "daysAge",
            "title": "อายุ (วัน)",
            "width": 80,
            "sortable": true,
            "format": "number",
            "align": "right"
          }
        ]
      },
      "styleConfig": {
        "showPagination": true,
        "pageSize": 25,
        "pageSizeOptions": [10, 25, 50, 100],
        "showSearch": true,
        "showExport": true,
        "exportFormats": ["excel", "pdf"],
        "striped": true,
        "bordered": true,
        "hoverable": true,
        "compact": false,
        "headerBackground": "#1f2937",
        "headerColor": "#f9fafb"
      },
      "filterConfig": {
        "enabled": true,
        "showFilterBar": true,
        "autoApply": true,
        "filters": [
          {
            "column": "dataDate",
            "operator": ">=",
            "label": "ตั้งแต่วันที่"
          },
          {
            "column": "dataDate",
            "operator": "<=",
            "label": "จนถึงวันที่"
          },
          {
            "column": "prodGrp",
            "type": "select",
            "label": "กลุ่มสินค้า",
            "options": "dynamic",
            "placeholder": "เลือกกลุ่มสินค้า...",
            "operator": "=",
            "visible": true
          },
          {
            "column": "branch",
            "type": "select",
            "label": "สาขา",
            "options": "dynamic",
            "placeholder": "เลือกสาขา...",
            "operator": "=",
            "visible": true
          },
          {
            "column": "prodName",
            "type": "text",
            "label": "ชื่อสินค้า",
            "placeholder": "ค้นหาชื่อสินค้า...",
            "operator": "contains",
            "visible": true
          },
          {
            "column": "buyPrice",
            "type": "number",
            "label": "ราคาซื้อ (ขั้นต่ำ)",
            "placeholder": "ราคาขั้นต่ำ...",
            "operator": ">=",
            "visible": true
          },
          {
            "column": "daysAge",
            "type": "number",
            "label": "อายุสูงสุด (วัน)",
            "placeholder": "อายุสูงสุด...",
            "operator": "<=",
            "defaultValue": 365,
            "visible": true
          },
          {
            "column": "docDate",
            "type": "date",
            "label": "วันที่เอกสาร",
            "placeholder": "เลือกวันที่...",
            "operator": ">=",
            "visible": true
          }
        ]
      },
      "conditionalFormatting": [
        {
          "field": "daysAge",
          "condition": "value > 180",
          "style": {
            "backgroundColor": "#fee2e2",
            "color": "#dc2626",
            "fontWeight": "bold"
          }
        },
        {
          "field": "daysAge",
          "condition": "value > 90 && value <= 180",
          "style": {
            "backgroundColor": "#fef3c7",
            "color": "#d97706"
          }
        },
        {
          "field": "daysAge",
          "condition": "value <= 30",
          "style": {
            "backgroundColor": "#dcfce7",
            "color": "#16a34a"
          }
        },
        {
          "field": "totalFromBuyPrice",
          "condition": "value > 50000",
          "style": {
            "backgroundColor": "#dbeafe",
            "color": "#2563eb",
            "fontWeight": "bold"
          }
        },
        {
          "field": "buyPrice",
          "condition": "value < 100",
          "style": {
            "color": "#6b7280",
            "fontStyle": "italic"
          }
        }
      ],
      "visible": true,
      "refreshInterval": 300000
    },
    {
      "id": "widget_advanced_kpi_001",
      "title": "💰 Total Revenue KPI",
