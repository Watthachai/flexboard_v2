{
  "layout": "grid",
  "theme": "light",
  "gridCols": 12,
  "gridRowHeight": 100,
  "widgets": [
    {
      "id": "widget_1",
      "title": "Top 10 Products by Sales",
      "type": "bar",
      "position": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "dataConfig": {
        "table": "VVPVSG_INVENTORY_001_VIEW_001",
        "xField": "prodName",
        "yField": "totalFromBuyPrice",
        "aggregation": "sum",
        "groupBy": ["prodName"],
        "orderBy": [{ "field": "totalFromBuyPrice", "direction": "DESC" }],
        "limit": 10
      },
      "styleConfig": {
        "color": "#3b82f6",
        "showLegend": true,
        "showGrid": true,
        "showLabels": true
      },
      "tooltipConfig": {
        "enabled": true,
        "format": "{prodName}: ฿{totalFromBuyPrice}"
      },
      "visible": true
    },
    {
      "id": "widget_2",
      "title": "Sales Trend Over Time",
      "type": "line",
      "position": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "dataConfig": {
        "table": "VVPVSG_INVENTORY_001_VIEW_001",
        "xField": "docDate",
        "yField": "totalFromBuyPrice",
        "aggregation": "sum",
        "groupBy": ["docDate"],
        "orderBy": [{ "field": "docDate", "direction": "ASC" }]
      },
      "styleConfig": {
        "color": "#10b981",
        "showLegend": true,
        "showGrid": true,
        "showLabels": true
      },
      "tooltipConfig": {
        "enabled": true,
        "format": "{docDate}: ฿{totalFromBuyPrice}"
      },
      "visible": true
    },
    {
      "id": "widget_3",
      "title": "Sales by Branch",
      "type": "bar",
      "position": { "x": 0, "y": 4, "w": 6, "h": 4 },
      "dataConfig": {
        "table": "VVPVSG_INVENTORY_001_VIEW_001",
        "xField": "branch",
        "yField": "totalFromBuyPrice",
        "aggregation": "sum",
        "groupBy": ["branch"],
        "orderBy": [{ "field": "totalFromBuyPrice", "direction": "DESC" }]
      },
      "styleConfig": {
        "color": "#f59e0b",
        "showLegend": true,
        "showGrid": true,
        "showLabels": true
      },
      "tooltipConfig": {
        "enabled": true,
        "format": "Branch {branch}: ฿{totalFromBuyPrice}"
      },
      "visible": true
    },
    {
      "id": "widget_4",
      "title": "Sales by Product Group",
      "type": "pie",
      "position": { "x": 6, "y": 4, "w": 4, "h": 4 },
      "dataConfig": {
        "table": "VVPVSG_INVENTORY_001_VIEW_001",
        "xField": "prodGrp",
        "yField": "totalFromBuyPrice",
        "aggregation": "sum",
        "groupBy": ["prodGrp"],
        "orderBy": [{ "field": "totalFromBuyPrice", "direction": "DESC" }],
        "limit": 8
      },
      "styleConfig": {
        "showLegend": true,
        "showLabels": true
      },
      "tooltipConfig": {
        "enabled": true,
        "format": "{prodGrp}: ฿{totalFromBuyPrice}"
      },
      "visible": true
    },
    {
      "id": "widget_5",
      "title": "Total Sales",
      "type": "kpi",
      "position": { "x": 10, "y": 4, "w": 2, "h": 2 },
      "dataConfig": {
        "table": "VVPVSG_INVENTORY_001_VIEW_001",
        "yField": "totalFromBuyPrice",
        "aggregation": "sum"
      },
      "styleConfig": {
        "color": "#ef4444",
        "prefix": "฿",
        "suffix": ""
      },
      "visible": true
    },
    {
      "id": "widget_6",
      "title": "Average Buy Price Trend",
      "type": "line",
      "position": { "x": 0, "y": 8, "w": 6, "h": 4 },
      "dataConfig": {
        "table": "VVPVSG_INVENTORY_001_VIEW_001",
        "xField": "docDate",
        "yField": "buyPrice",
        "aggregation": "avg",
        "groupBy": ["docDate"],
        "orderBy": [{ "field": "docDate", "direction": "ASC" }]
      },
      "styleConfig": {
        "color": "#8b5cf6",
        "showLegend": true,
        "showGrid": true,
        "showLabels": true
      },
      "tooltipConfig": {
        "enabled": true,
        "format": "{docDate}: ฿{buyPrice}"
      },
      "visible": true
    },
    {
      "id": "widget_7",
      "title": "Total Quantity",
      "type": "kpi",
      "position": { "x": 10, "y": 6, "w": 2, "h": 2 },
      "dataConfig": {
        "table": "VVPVSG_INVENTORY_001_VIEW_001",
        "yField": "qtyFromThisDoc",
        "aggregation": "sum"
      },
      "styleConfig": {
        "color": "#06b6d4",
        "prefix": "",
        "suffix": " units"
      },
      "visible": true
    },
    {
      "id": "widget_8",
      "title": "Inventory Age Analysis",
      "type": "bar",
      "position": { "x": 6, "y": 8, "w": 6, "h": 4 },
      "dataConfig": {
        "table": "VVPVSG_INVENTORY_001_VIEW_001",
        "xField": "ageBucket",
        "yField": "totalFromBuyPrice",
        "aggregation": "sum",
        "groupBy": ["ageBucket"],
        "orderBy": [{ "field": "totalFromBuyPrice", "direction": "DESC" }],
        "limit": 10
      },
      "styleConfig": {
        "color": "#ec4899",
        "showLegend": true,
        "showGrid": true,
        "showLabels": true
      },
      "tooltipConfig": {
        "enabled": true,
        "format": "Age: {ageBucket} - ฿{totalFromBuyPrice}"
      },
      "visible": true
    }
  ],
  "autoRefresh": false,
  "refreshInterval": 0
}
